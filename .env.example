# ============================================================================
# DevPilot — Environment Variables Configuration Template
# ============================================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit your secret service_role keys to Git.

# ── 1. SUPABASE CLOUD DATABASE & AUTHENTICATION (Vite Standard) ──
# Create a free project at https://supabase.com
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Optional backward compatibility / alternative keys
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# ── 2. PLATFORM OWNER / ADMINISTRATOR ACCOUNTS ──
# Comma-separated list of emails with access to the Admin Dashboard
VITE_ADMIN_EMAILS=devanshjain996@gmail.com

# ── 3. GOOGLE OAUTH SETUP ──
# In Supabase Dashboard -> Authentication -> Providers -> Google:
# 1. Enable Google provider
# 2. Enter Client ID and Client Secret from Google Cloud Console (APIs & Services -> Credentials)
# 3. Add Authorized Redirect URI in Google Cloud Console:
#    https://your-project-id.supabase.co/auth/v1/callback

# ── 4. PHONE OTP SMS SETUP ──
# In Supabase Dashboard -> Authentication -> Providers -> Phone:
# 1. Enable Phone provider
# 2. Select SMS Provider (Twilio or Supabase Native SMS)
# 3. Configure Twilio Account SID, Auth Token, and Sender Number
